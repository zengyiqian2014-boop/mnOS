#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Configure explicit, group-scoped network capabilities; never grant UID 0."""
import grp
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys

HELPER = Path('/usr/lib/mnos/net-admin')
POLICY = Path('/etc/mnos/network-policy')
GROUP = 'mnos-netadmin'


def run(args):
    return subprocess.run(args, check=True, env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'})


def configure(mode, username=None):
    if os.getuid() != 0 or os.geteuid() != 0:
        raise PermissionError('Only root can change network delegation.')
    if mode not in ('root', 'netadmin') or (mode == 'root' and username is not None):
        raise ValueError('Usage: mnos-network-policy root | netadmin USER')
    if mode == 'netadmin':
        if not username or not re.fullmatch(r'[a-z][a-z0-9_-]{0,30}', username):
            raise ValueError('Invalid username.')
        user = pwd.getpwnam(username)
        if user.pw_uid < 1000 or user.pw_uid == 65534:
            raise ValueError('Choose an ordinary local account.')
    group = grp.getgrnam(GROUP)
    if HELPER.is_symlink() or not HELPER.is_file():
        raise ValueError('Network helper must be a regular root-owned file.')
    os.chown(HELPER, 0, group.gr_gid)
    os.chmod(HELPER, 0o750)
    # Remove capabilities first so partial reconfiguration always fails closed.
    try:
        os.removexattr(HELPER, 'security.capability')
    except OSError as error:
        import errno
        if error.errno != errno.ENODATA:
            raise
    POLICY.parent.mkdir(parents=True, exist_ok=True)
    POLICY.write_text('root\n')
    POLICY.chmod(0o644)
    if mode == 'netadmin':
        run(['/usr/sbin/usermod', '-a', '-G', GROUP, username])
        run(['/usr/sbin/setcap', 'cap_net_admin,cap_net_raw=ep', str(HELPER)])
        run(['/usr/sbin/setcap', '-v', 'cap_net_admin,cap_net_raw=ep', str(HELPER)])
        POLICY.write_text('netadmin\n')
        print('Network delegation enabled. Sign out and back in to refresh groups.')
    else:
        run(['/usr/bin/gpasswd', '-M', '', GROUP])
        print('Network delegation disabled. End existing network-tool sessions to revoke inherited capabilities.')


if __name__ == '__main__':
    try:
        if len(sys.argv) not in (2, 3):
            raise ValueError('Usage: mnos-network-policy root | netadmin USER')
        configure(sys.argv[1], sys.argv[2] if len(sys.argv) == 3 else None)
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
