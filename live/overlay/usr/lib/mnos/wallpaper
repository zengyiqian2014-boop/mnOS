"""Set a default for the actual monitor name once; preserve subsequent changes."""
from pathlib import Path
import re
import subprocess
import time

marker = Path.home() / '.config/mnos/wallpaper-set'
if not marker.exists():
    for _ in range(15):
        display = subprocess.run(['xrandr', '--query'], capture_output=True,
                                 text=True).stdout
        monitors = re.findall(r'^(\S+) connected(?: primary)? \d+x\d+', display, re.M)
        props = subprocess.run(['xfconf-query', '-c', 'xfce4-desktop', '-l'],
                               capture_output=True, text=True).stdout.splitlines()
        # The packaged monitor0 fallback is not the output name used by Xfce 4.20.
        # Create defaults for connected outputs before xfdesktop's first draw.
        targets = {f'/backdrop/screen0/monitor{name}/workspace{workspace}/last-image'
                   for name in monitors for workspace in range(2)}
        targets.update(p for p in props if any(f'/monitor{name}/' in p for name in monitors)
                       and re.fullmatch(r'/backdrop/screen\d+/monitor[^/]+/workspace\d+/last-image', p))
        if monitors:
            for prop in targets:
                subprocess.run(['xfconf-query', '-c', 'xfce4-desktop', '-p', prop,
                                '--create', '--type', 'string',
                                '--set', '/usr/share/backgrounds/mnos/default.svg'], check=True)
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.touch()
            break
        time.sleep(1)
