#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Installer backend. Never selects a destination implicitly. Secrets use stdin.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8
umask 077
ulimit -c 0
fail() { echo "INSTALL ERROR: $*" >&2; exit 1; }
list_disks() {
    lsblk --json --bytes --paths -o PATH,TYPE,SIZE,RO,MODEL,MOUNTPOINTS |
        jq '[.blockdevices[] | select(.type == "disk" and .ro == false and .size >= 34359738368) |
            select([.. | objects | .mountpoints? // [] | .[] | select(. != null)] | length == 0) |
            {path, size, model}]'
}
case "${1:-}" in
    --list) list_disks; exit 0 ;;
    --install) [ "$#" = 4 ] && [ "$3" = --confirm ] || fail 'Expected --install DEVICE --confirm DEVICE' ;;
    *) fail 'Use --list or --install DEVICE --confirm DEVICE' ;;
esac
[ "$(id -u)" = 0 ] || fail 'Administrator authentication required.'
grep -qw 'boot=live' /proc/cmdline || fail 'Run from the installation ISO.'
disk=$(readlink -f -- "$2")
[ "$disk" = "$2" ] && [ "$disk" = "$4" ] && [ -b "$disk" ] || fail 'Disk confirmation does not match.'
exec 9>/run/mnos-install.lock
flock -n 9 || fail 'Another installation is running.'
list_disks | jq -e --arg disk "$disk" 'any(.[]; .path == $disk)' >/dev/null || fail 'Disk is mounted, read-only, too small, or not a whole disk.'
IFS= read -r account || fail 'Missing account.'
IFS= read -r secret || fail 'Missing password.'
read -r policy || fail 'Missing network policy.'
case "$policy" in root|delegated) ;; *) fail 'Invalid network policy.' ;; esac
password_hash=$(printf '%s\n%s\n' "$account" "$secret" |
    /usr/lib/mnos/account-preflight --hash) || fail 'Account validation failed before disk changes.'
unset secret
[[ "$password_hash" == '$y$'* ]] || fail 'Password hashing did not produce a usable account.'
medium=/run/live/medium
[ -r "$medium/live/filesystem.squashfs" ] && [ -r "$medium/live/filesystem.sha256" ] || fail 'Installation payload is missing.'
echo 'STAGE 5 Checking installation media / 检查安装介质'
(cd "$medium/live" && sha256sum -c filesystem.sha256) || fail 'Installation media is damaged.'
arch=$(dpkg --print-architecture)
case "$arch" in amd64) efi=x86_64-efi; suffix=x64 ;; arm64) efi=arm64-efi; suffix=aa64
    [ -d /sys/firmware/efi ] || fail 'ARM64 installation requires UEFI.' ;; *) fail 'Unsupported architecture.' ;; esac
# Recheck after media verification, immediately before the first destructive write.
list_disks | jq -e --arg disk "$disk" 'any(.[]; .path == $disk)' >/dev/null || fail 'Destination became unavailable.'
target=$(mktemp -d /mnt/mnos-install.XXXXXX)
cleanup() {
    unset secret password_hash
    sync
    if mountpoint -q "$target"; then umount -R "$target" || true; fi
    rmdir "$target" 2>/dev/null || true
}
trap cleanup EXIT
echo 'STAGE 10 Creating disk partitions / 创建磁盘分区'
# A BIOS boot partition and ESP make the SAME amd64 disk bootable by BIOS or UEFI.
wipefs --all "$disk"
sgdisk --zap-all --new=1:2048:+2M --typecode=1:ef02 --change-name=1:BIOS \
    --new=2:0:+1G --typecode=2:ef00 --change-name=2:EFI \
    --new=3:0:0 --typecode=3:8300 --change-name=3:mnOS "$disk"
partprobe "$disk"
udevadm settle --timeout=30
part() { lsblk -nrpo PATH,PARTN "$disk" | awk -v n="$1" '$2 == n {print $1}'; }
esp=$(part 2); root=$(part 3)
[ -b "$esp" ] && [ -b "$root" ] || fail 'New partitions were not detected.'
mkfs.vfat -F 32 -n MNOS_EFI "$esp"
mkfs.ext4 -F -L mnOS -E lazy_itable_init=0,lazy_journal_init=0 "$root"
mount "$root" "$target"
echo 'STAGE 20 Installing system and applications / 安装系统和应用'
unsquashfs -f -no-progress -processors 2 -d "$target" "$medium/live/filesystem.squashfs"
# Also deploy the account-login fix when the ISO carries a verified installer
# overlay over an older base filesystem. Never patch PAM or enable autologin.
for unit in getty@.service serial-getty@.service; do
    install -D -m 644 "/etc/systemd/system/$unit.d/20-account-login.conf" \
        "$target/etc/systemd/system/$unit.d/20-account-login.conf"
done
mkdir -p "$target/boot/efi"
mount "$esp" "$target/boot/efi"
root_uuid=$(blkid -s UUID -o value "$root")
esp_uuid=$(blkid -s UUID -o value "$esp")
printf 'UUID=%s / ext4 defaults,errors=remount-ro 0 1\nUUID=%s /boot/efi vfat umask=0077 0 2\n' "$root_uuid" "$esp_uuid" > "$target/etc/fstab"
for dir in dev proc sys run; do
    mount --rbind "/$dir" "$target/$dir"
    mount --make-rslave "$target/$dir"
done
echo 'STAGE 65 Creating your account / 创建用户账号'
chroot "$target" useradd --create-home --shell /bin/bash --groups sudo,netdev,plugdev "$account"
printf '%s:%s\n' "$account" "$password_hash" | chroot "$target" chpasswd --encrypted
unset password_hash
chroot "$target" passwd --lock root
if [ "$policy" = delegated ]; then
    chroot "$target" /usr/sbin/mnos-network-policy netadmin "$account"
else
    chroot "$target" /usr/sbin/mnos-network-policy root
fi
install -d -m 755 "$target/var/lib/mnos"
printf '%s\n' "$account" > "$target/var/lib/mnos/setup-complete"
printf 'mnOS\n' > "$target/etc/hostname"
printf '127.0.0.1 localhost\n127.0.1.1 mnOS\n::1 localhost ip6-localhost ip6-loopback\n' > "$target/etc/hosts"
printf 'LANG=en_US.UTF-8\n' > "$target/etc/default/locale"
rm -f "$target/etc/machine-id" "$target/var/lib/dbus/machine-id" "$target/var/lib/systemd/random-seed"
touch "$target/etc/machine-id"
chmod 644 "$target/etc/machine-id"
ln -s /etc/machine-id "$target/var/lib/dbus/machine-id"
chroot "$target" systemctl disable mnos-first-boot mnos-installer
chroot "$target" systemctl enable lightdm getty@tty1
case "$arch" in amd64) serial=ttyS0 ;; arm64) serial=ttyAMA0 ;; esac
if [ -c "/dev/$serial" ]; then
    # An authenticated maintenance console, useful on servers and headless VMs.
    chroot "$target" systemctl enable "serial-getty@$serial.service"
fi
chroot "$target" systemctl set-default graphical.target
printf '#!/bin/sh\nexit 101\n' > "$target/usr/sbin/policy-rc.d"
chmod 755 "$target/usr/sbin/policy-rc.d"
echo 'STAGE 75 Configuring hardware and bootloader / 配置硬件和引导'
chroot "$target" update-initramfs -u -k all
# Signed fallback EFI path boots even when the VM recreates its NVRAM.
mkdir -p "$target/boot/efi/EFI/BOOT" "$target/boot/efi/EFI/debian" "$target/boot/grub"
cp -a "$target/usr/lib/grub/$efi" "$target/boot/grub/"
cp "$target/usr/lib/shim/shim$suffix.efi.signed" "$target/boot/efi/EFI/BOOT/BOOT${suffix^^}.EFI"
cp "$target/usr/lib/grub/$efi-signed/grub$suffix.efi.signed" "$target/boot/efi/EFI/BOOT/grub$suffix.efi"
if [ -f "$target/usr/lib/shim/mm$suffix.efi" ]; then cp "$target/usr/lib/shim/mm$suffix.efi" "$target/boot/efi/EFI/BOOT/"; fi
cat > "$target/boot/efi/EFI/BOOT/grub.cfg" <<EOF
search --no-floppy --fs-uuid --set=root $root_uuid
set prefix=(\$root)/boot/grub
configfile \$prefix/grub.cfg
EOF
cp "$target/boot/efi/EFI/BOOT/grub.cfg" "$target/boot/efi/EFI/debian/grub.cfg"
if [ "$arch" = amd64 ]; then chroot "$target" grub-install --target=i386-pc --recheck "$disk"; fi
chroot "$target" update-grub
if [ -d /sys/firmware/efi ]; then
    if ! efibootmgr --create --disk "$disk" --part 2 --label mnOS \
        --loader "\\EFI\\BOOT\\BOOT${suffix^^}.EFI"; then
        echo 'WARNING: Firmware did not accept a boot entry. Select the EFI Boot entry for this disk in firmware settings.'
    fi
fi
rm -f "$target/usr/sbin/policy-rc.d"
printf '%s\n' "$arch" > "$target/var/lib/mnos/installed-architecture"
chmod 644 "$target/var/lib/mnos/installed-architecture"
jq -n --arg arch "$arch" --arg source "$(cat "$target/etc/mnos/source-commit")" \
    --arg uuid "$root_uuid" --arg account "$account" \
    '{architecture:$arch,source_commit:$source,root_uuid:$uuid,account:$account}' \
    > "$target/var/lib/mnos/installation.json"
rm -f "$target/usr/share/applications/install-mnos.desktop" "$target/usr/share/applications/calamares-install-debian.desktop"
sync
echo 'STAGE 100 Installation complete. Remove the ISO before rebooting. / 安装完成，请移除 ISO 后重启。'
echo 'MNOS INSTALL PASS'
