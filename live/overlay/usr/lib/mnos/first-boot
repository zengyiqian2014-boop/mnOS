"""Local enrollment. No baked-in account, password, or network enrollment API."""
import getpass
import os
from pathlib import Path
import re
import subprocess
import sys

MARKER = Path('/var/lib/mnos/setup-complete')


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def enroll():
    if os.geteuid() != 0:
        raise SystemExit('Local enrollment must run as root.')
    if MARKER.exists():
        return
    print('\033[2J\033[H\033[1;36mmnOS / Desktop\033[0m\n')
    print('Create your local administrator account.\n')
    print('This live session runs in RAM. Install to a disk to keep your changes.')
    print('No default password is provided. Root login stays locked.\n')
    while True:
        username = input('Username [mnos]: ').strip() or 'mnos'
        if not re.fullmatch(r'[a-z][a-z0-9_-]{0,30}', username):
            print('Use 1-31 lower-case letters, digits, underscores or hyphens.')
            continue
        if subprocess.run(['getent', 'passwd', username], stdout=subprocess.DEVNULL).returncode == 0:
            print('That account already exists. Choose another name.')
            continue
        password = getpass.getpass('Password (12+ characters): ')
        if len(password) < 12 or len(password) > 512:
            print('Use between 12 and 512 characters.')
            continue
        quality = subprocess.run(['pwscore', username], input=password + '\n',
                                 text=True, capture_output=True)
        if quality.returncode:
            print(quality.stderr.strip() or 'Choose a less predictable password.')
            continue
        if password != getpass.getpass('Confirm password: '):
            print('Passwords do not match.')
            continue
        run(['useradd', '--create-home', '--shell', '/bin/bash',
             '--groups', 'sudo,netdev,plugdev', username])
        try:
            run(['chpasswd'], input=username + ':' + password + '\n', text=True)
        except subprocess.CalledProcessError:
            run(['userdel', '--remove', username])
            print('Could not set the password. Please try again.')
            continue
        finally:
            password = None
        # The marker contains no password or other authentication material.
        MARKER.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        MARKER.write_text(username + '\n')
        MARKER.chmod(0o600)
        print('\nAccount ready. Starting the graphical login screen...')
        return


if __name__ == '__main__':
    try:
        enroll()
    except (EOFError, KeyboardInterrupt):
        print('\nSetup interrupted. No desktop session has been unlocked.', file=sys.stderr)
        raise SystemExit(1)
