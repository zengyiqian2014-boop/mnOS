#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
case "$1" in
    deconfig) ip addr flush dev "$interface" ;;
    bound|renew)
        /usr/local/lib/mnos/busybox ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
        ip route flush default dev "$interface"
        for gateway in $router; do ip route add default via "$gateway" dev "$interface"; break; done
        : > /etc/resolv.conf
        for server in $dns; do printf 'nameserver %s\n' "$server" >> /etc/resolv.conf; done
        ;;
esac
exit 0
